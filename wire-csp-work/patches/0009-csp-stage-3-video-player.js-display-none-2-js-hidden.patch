Subject: [PATCH 09/23] csp stage 3: video-player.js display:none (2) ->
 js-hidden; video-time shows as 'block' (same as '' for a div with no display
 rule)

---
 public/js/media/video-player.js | 10 +++++-----
 public/sw-manifest.js           |  4 ++--
 tests/csp-static.test.mjs       |  1 -
 3 files changed, 7 insertions(+), 8 deletions(-)

diff --git a/public/js/media/video-player.js b/public/js/media/video-player.js
index 18eb09a..f79a171 100644
--- a/public/js/media/video-player.js
+++ b/public/js/media/video-player.js
@@ -132,16 +132,16 @@ export async function renderVideo(
           </span>
 
           <span
-            class="icon-pause"
-            style="display:none"
+            class="icon-pause js-hidden"
+           
           >
             ${ICONS.pause}
           </span>
         </button>
 
         <div
-          class="video-time"
-          style="display:none"
+          class="video-time js-hidden"
+         
         >
           <span class="current-time">
             0:00
@@ -540,7 +540,7 @@ export async function renderVideo(
 
     videoTime.style.display =
       isPlayerFullscreen()
-        ? ''
+        ? 'block'
         : 'none';
   };
 
