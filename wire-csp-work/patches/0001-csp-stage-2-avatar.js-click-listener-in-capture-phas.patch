From 23123dac5006dcdeae471648cdec77948e982fb3 Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Fri, 6 Nov 2026 04:01:51 +0000
Subject: [PATCH 01/23] csp stage 2: avatar.js click listener in capture phase
 so ancestors do not double-fire

Bubble-phase listener let DM picker row (and other ancestors) run before
stopPropagation(). Capture phase restores the old inline-onclick ordering.
---
 public/js/ui/avatar.js | 5 ++++-
 public/sw-manifest.js  | 4 ++--
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/public/js/ui/avatar.js b/public/js/ui/avatar.js
index de3fe1c..a4d62fb 100644
--- a/public/js/ui/avatar.js
+++ b/public/js/ui/avatar.js
@@ -314,12 +314,15 @@ export function avatarHtml(userId, username, className = 'chat-avatar', showPres
 }
 
 // Click handling for avatars (scoped to data-avatar-action="profile").
+// Capture phase on purpose: the old inline onclick ran before any ancestor
+// listener, and stopPropagation() must stop ancestors (e.g. the DM picker row)
+// from also acting on the same click.
 if (typeof document !== 'undefined') document.addEventListener('click', (e) => {
   const el = e.target.closest('.clickable-avatar[data-avatar-action="profile"]');
   if (!el) return;
   e.stopPropagation();
   window.openProfileCard(Number(el.dataset.avatarUser));
-});
+}, true);
 
 /**
  * Generate HTML for a banner placeholder and schedule its image load.
diff --git a/public/sw-manifest.js b/public/sw-manifest.js
index d47d049..b0aedd1 100644
--- a/public/sw-manifest.js
+++ b/public/sw-manifest.js
@@ -1,7 +1,7 @@
 // GENERATED by scripts/build-sw-manifest.mjs — do not edit by hand.
 // Re-run it on every deploy; `--check` verifies it is current.
 self.WIRE_SHELL = {
- "version": "04dbed6cf97a",
+ "version": "c93f343a478a",
  "files": [
   {
    "url": "/css/components/badges.css",
@@ -685,7 +685,7 @@ self.WIRE_SHELL = {
   },
   {
    "url": "/js/ui/avatar.js",
-   "rev": "f594a04758b7862e0bb31b83583dd3dcfeaed587492b4e2cd85116ecceffc489"
+   "rev": "c88991678aaf479af83c4d145aef6b1864580068ca9128ac6d4492278e8f7635"
   },
   {
    "url": "/js/ui/confirm.js",
