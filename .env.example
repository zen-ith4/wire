# Server Configuration
PORT=3002
HOST=127.0.0.1
NODE_ENV=development

# Setup Wizard Flag (Set to true automatically after first run) mitonid falsesh konid agar bara test mikhayd
SETUP_COMPLETED=false

# WireGuard Configuration
ALLOWED_SUBNET=0.0.0.0/0
WG_INTERFACE=wg0

# Database & Security
DB_PATH=./data.db

# change this (you can use openssl rand -hex 32)
JWT_SECRET=a7f3c9e2d1b80456fe2a8c91d4b673e5f01a9c8d7e3b2456a0c7d8e9f1b2c3d4

# Email OTP
EMAIL_ENABLED=true

EMAIL_VERIFICATION_SECRET=z6cfcf37ecf2f3956197d01ef9cb1138f020af4b8760f959ddd310df5d0529be7

# (you can use any provider you want)
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_USER=....
SMTP_PASSWORD=....
SMTP_FROM="Wire <no-reply@...>"

# Android APK update (optional — leave unset to disable the
# Android in-app update prompt entirely; Electron/browser are
# unaffected either way)
# APK_PATH=./apk-debug.apk
# APK_VERSION_NAME=1.3.0
# APK_VERSION_CODE=13
# APK_PACKAGE_ID=com.wireapp.arman

# File System & Upload Limits
USER_DATA_ROOT=./user-data
CHAT_UPLOAD_DIR=./chat-uploads
CHAT_UPLOAD_MAX_MB=50
DM_UPLOAD_DIR=./dm-uploads
# Max PLAINTEXT size of one DM attachment (the encrypted upload is ~0.025% larger).
# DM_UPLOAD_MAX_MB=50
# DM attachments are end-to-end encrypted in the client before upload; with
# this ON (default) the server rejects plaintext DM uploads. Set to false
# ONLY to roll back: plaintext uploads are then accepted again (legacy path).
# DM_E2EE_ATTACHMENTS_ENFORCED=true
AVATAR_DIR=./avatars
AVATAR_MAX_MB=10
UPLOAD_MAX_MB=2048

# E2EE group chat (off by default; when false the Groups UI is hidden and
# every /api/groups request and group socket event is refused)
GROUPS_ENABLED=false
# GROUP_UPLOAD_DIR=./group-uploads
# GROUP_UPLOAD_MAX_MB=50

# Content-Security-Policy. Default (unset/false) = Report-Only: violations
# are logged in the browser console, nothing is blocked. Set to true to
# ENFORCE. Do not enforce until the legacy inline handlers are removed
# (see docs/CSP_TODO.md), or parts of the UI will stop responding.
CSP_ENFORCE=false
