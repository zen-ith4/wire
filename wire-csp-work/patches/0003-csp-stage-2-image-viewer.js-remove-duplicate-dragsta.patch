From 5097c6e575886b03c6f4a44f233cda5a0cc487d9 Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Fri, 6 Nov 2026 04:04:47 +0000
Subject: [PATCH 03/23] csp stage 2: image-viewer.js remove duplicate dragstart
 preventDefault listener

---
 public/js/media/image-viewer.js | 8 +++-----
 public/sw-manifest.js           | 4 ++--
 2 files changed, 5 insertions(+), 7 deletions(-)

diff --git a/public/js/media/image-viewer.js b/public/js/media/image-viewer.js
index 85e891d..1cdeaaa 100644
--- a/public/js/media/image-viewer.js
+++ b/public/js/media/image-viewer.js
@@ -202,7 +202,9 @@ registerActions({
   const stage = document.querySelector('.image-viewer-stage');
   if (!img || !stage) return;
 
-  // Was an inline ondragstart="return false;" in index.html.
+  // Was an inline ondragstart="return false;" in index.html. Also covers
+  // native drag-and-drop ghost thumbnails that can appear even with
+  // draggable="false" on slow paint cycles.
   img.addEventListener('dragstart', (e) => e.preventDefault());
 
   const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
@@ -334,10 +336,6 @@ registerActions({
     img.classList.remove('panning');
   });
 
-  // Belt-and-suspenders: some browsers still attempt native
-  // image drag-and-drop (the "ghost thumbnail" in the middle of
-  // the screen) even with draggable="false" on slow paint cycles.
-  img.addEventListener('dragstart', (e) => e.preventDefault());
 })();
 
 // Escape-to-close, registered once — same pattern as the profile
diff --git a/public/sw-manifest.js b/public/sw-manifest.js
index b0aedd1..35ae8d7 100644
--- a/public/sw-manifest.js
+++ b/public/sw-manifest.js
@@ -1,7 +1,7 @@
 // GENERATED by scripts/build-sw-manifest.mjs — do not edit by hand.
 // Re-run it on every deploy; `--check` verifies it is current.
 self.WIRE_SHELL = {
- "version": "c93f343a478a",
+ "version": "d03edf636b6d",
  "files": [
   {
    "url": "/css/components/badges.css",
@@ -549,7 +549,7 @@ self.WIRE_SHELL = {
   },
   {
    "url": "/js/media/image-viewer.js",
-   "rev": "805066417333d06c62cfba270213b5578b39a5c91a9bda99327c5d7bb3998038"
+   "rev": "2036392b780b5ba396b760ad49ee878da1dd5edd50cfc6b9cd5fae0dad200954"
   },
   {
    "url": "/js/media/lazy-e2ee-media.js",
-- 
