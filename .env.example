# Server Configuration
PORT=3002
HOST=127.0.0.1
NODE_ENV=development

# Setup Wizard Flag (Set to true automatically after first run) mitonid falsesh konid agar bara test mikhayd
SETUP_COMPLETED=false

# WireGuard Configuration
ALLOWED_SUBNET=0.0.0.0/0
WG_INTERFACE=wg0

# Database & Security
DB_PATH=./data.db

# REQUIRED. Replace CHANGE_ME with a random value of at least 32 characters
# (openssl rand -hex 32). The server refuses to start with this placeholder.
JWT_SECRET=CHANGE_ME

# Email OTP
EMAIL_ENABLED=true

# REQUIRED (and mandatory in production). Replace CHANGE_ME with a random value
# of at least 32 characters (openssl rand -hex 32).
EMAIL_VERIFICATION_SECRET=CHANGE_ME

# (you can use any provider you want)
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_USER=....
SMTP_PASSWORD=....
SMTP_FROM="Wire <no-reply@...>"

# Android APK update (optional — leave unset to disable the
# Android in-app update prompt entirely; Electron/browser are
# unaffected either way)
# Updated clients refuse to install an update from a server that does
# not advertise an sha256 (the /api/apk/info fail-closed behaviour).
# Preferred default: ./app-debug.apk (falls back to the legacy ./apk-debug.apk
# name if the new build artifact is not present).
# APK_PATH=./app-debug.apk
# APK_VERSION_NAME=1.3.0
# APK_VERSION_CODE=13
# APK_PACKAGE_ID=com.wireapp.arman

# File System & Upload Limits
USER_DATA_ROOT=./user-data
CHAT_UPLOAD_DIR=./chat-uploads
CHAT_UPLOAD_MAX_MB=50
DM_UPLOAD_DIR=./dm-uploads
# Max PLAINTEXT size of one DM attachment (the encrypted upload is ~0.025% larger).
# DM_UPLOAD_MAX_MB=50
# DM attachments are end-to-end encrypted in the client before upload; with
# this ON (default) the server rejects plaintext DM uploads. Set to false
# ONLY to roll back: plaintext uploads are then accepted again (legacy path).
# DM_E2EE_ATTACHMENTS_ENFORCED=true
# The same rule for DM text and edits: with this ON (default) the server rejects
# anything that is not an encrypted envelope. Set to false ONLY to roll back: an
# old client's plaintext is then stored again, and a current client will hide it
# on any conversation it has already seen encrypted.
# DM_E2EE_TEXT_ENFORCED=true
AVATAR_DIR=./avatars
AVATAR_MAX_MB=10
UPLOAD_MAX_MB=2048

# E2EE group chat (off by default; when false the Groups UI is hidden and
# every /api/groups request and group socket event is refused)
GROUPS_ENABLED=false
# GROUP_UPLOAD_DIR=./group-uploads
# GROUP_UPLOAD_MAX_MB=50

# Content-Security-Policy. Default (unset/false) = Report-Only: violations
# are logged in the browser console, nothing is blocked. Set to true to
# ENFORCE. The front-end is CSP-clean (docs/archive/CSP_TODO.md lists the tests that
# assert it), so enforcing is supported; the tests run with CSP_ENFORCE=true.
CSP_ENFORCE=false

# ---- Variables the code reads that this file did not list (added 2026-11-09) ----
# Names and defaults are from config/constants.js unless another file is named.
# DM E2EE floor given to NEWLY CREATED accounts: unset = 2; "1" or "2"; anything else stops the server.
# DM_E2EE_DEFAULT_MIN_VERSION=2
# Public URL / CORS origin (config/constants.js, config/socket.js)
# PUBLIC_BASE_URL=
# CLIENT_URL=
# Extra roots administrators may share folders from (config/constants.js)
# ALLOWED_FOLDER_ROOTS=
# Banner images
# BANNER_DIR=./banners
# BANNER_MAX_MB=
# First-run admin (database/seed.js)
# DEFAULT_ADMIN_USER=
# DEFAULT_ADMIN_PASS=
# BCRYPT_ROUNDS=
# Email 2FA secret (services/email2fa.service.js)
# EMAIL_2FA_SECRET=
# Group device limits (services/groupKdm.service.js)
# GROUP_DEVICE_CAP=
# GROUP_DEVICE_NEW_PER_HOUR=
# GROUP_DEVICE_GRACE=
# GROUP_DEVICE_TTL_DAYS=
# Identity key rate limits (middleware/rateLimiter.js)
# IDENTITY_ROTATE_MAX_PER_HOUR=
# IDENTITY_HISTORY_MAX_PER_HOUR=
# Push notifications through Firebase (services/push.service.js)
# GOOGLE_APPLICATION_CREDENTIALS=
