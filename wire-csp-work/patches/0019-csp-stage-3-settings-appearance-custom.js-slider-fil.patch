Date: Fri, 6 Nov 2026 05:42:47 +0000
Subject: [PATCH 19/23] csp stage 3: settings-appearance-custom.js slider fill
 via data-sound-volume; display:block spans -> u-block

---
 public/js/settings/settings-appearance-custom.js | 11 ++++++-----
 public/sw-manifest.js                            |  4 ++--
 tests/csp-static.test.mjs                        |  1 -
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/public/js/settings/settings-appearance-custom.js b/public/js/settings/settings-appearance-custom.js
index b92e7f7..30ff20a 100644
--- a/public/js/settings/settings-appearance-custom.js
+++ b/public/js/settings/settings-appearance-custom.js
@@ -79,6 +79,7 @@ import {
 } from '../chat/message-accent.js';
 
 import { renderSettings } from './settings.js';
+import { applyDynamicVars } from '../ui/dynamic-vars.js';
 
 // ============================================================
 // Reusable controls
@@ -137,7 +138,7 @@ export function sliderRow({
           step="1"
           value="${value}"
           data-unit="${unit}"
-          style="--sound-volume:${fillPercent(value, min, max)}%"
+          data-sound-volume="${fillPercent(value, min, max)}"
           aria-label="${escapeHtmlAttr(label)}"
           ${attrs}
           ${disabled || hidden ? 'disabled' : ''}>
@@ -506,14 +507,14 @@ export function renderAdvancedAppearanceSection() {
       <summary class="settings-advanced-summary">
         <span>
           <span
-            class="settings-row-label"
-            style="display:block">
+            class="settings-row-label u-block"
+           >
             Advanced
           </span>
 
           <span
-            class="settings-row-sublabel"
-            style="display:block">
+            class="settings-row-sublabel u-block"
+           >
             Transparency and blur for each part of the interface
           </span>
         </span>
