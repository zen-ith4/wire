Subject: [PATCH 08/23] csp stage 3: admin.js inline style= (3) -> utility
 classes in utilities.css

---
 public/css/utilities.css    | 14 ++++++++++++++
 public/js/settings/admin.js |  8 ++++----
 public/sw-manifest.js       |  6 +++---
 tests/csp-static.test.mjs   |  1 -
 4 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/public/css/utilities.css b/public/css/utilities.css
index b799f9c..81159b5 100644
--- a/public/css/utilities.css
+++ b/public/css/utilities.css
@@ -1,2 +1,16 @@
 .text-muted{color:var(--muted);}
 .hidden{display:none !important;}
+
+/* Inline-style replacements (CSP). Deliberately NOT !important: JS toggles
+   these elements with el.style.display, and an inline value must still win. */
+.js-hidden{display:none;}
+.u-block{display:block;}
+.u-inline-flex-gap8{display:inline-flex;gap:8px;}
+.u-flex-center-gap10{display:flex;align-items:center;gap:10px;}
+.u-min-w-220{min-width:220px;}
+.u-min-w-260{min-width:260px;}
+.u-dm-empty-pad{font-size:12.5px;padding:16px 10px;text-align:center;}
+.u-dm-status-pad{font-size:12.5px;padding:10px 4px;}
+.u-m0{margin:0;}
+.u-pc-pad{padding:24px 4px;text-align:center;}
+.u-offscreen-copy{position:fixed;top:0;left:0;opacity:0;pointer-events:none;}
diff --git a/public/js/settings/admin.js b/public/js/settings/admin.js
index d4fdbe0..7523f97 100644
--- a/public/js/settings/admin.js
+++ b/public/js/settings/admin.js
@@ -35,7 +35,7 @@ export async function renderAdminUsers() {
       // admin hands it to another user and becomes a normal user.
       const actions = isSelf
         ? '<span class="text-muted">You (admin)</span>'
-        : `<div style="display:inline-flex;gap:8px;">
+        : `<div class="u-inline-flex-gap8">
             <button class="btn btn-sm" data-transfer-admin="${Number(u.id)}">Transfer admin role</button>
             <button class="btn btn-danger btn-sm" data-delete-user="${Number(u.id)}">Delete</button>
           </div>`;
@@ -62,7 +62,7 @@ export async function renderAdminUsers() {
       return `
       <tr class="file-row">
         <td>
-          <div style="display:flex;align-items:center;gap:10px;">
+          <div class="u-flex-center-gap10">
             ${avatarHtml(u.id, u.username, 'chat-avatar', false, true)}
             <span>${escapeHtml(u.username)}</span>
           </div>
@@ -486,11 +486,11 @@ export async function renderAdminFolders() {
       </div>
 
       <div class="toolbar">
-        <input
+        <input class="u-min-w-220"
           type="text"
           id="new-folder-path"
           placeholder="/srv/media/Movies"
-          style="min-width:220px;"
+         
         >
 
         <input
